{
  "$schema": "omarchy-theme-plan/v1",
  "name": "macOS 2026",
  "slug": "macos-2026",
  "mode": "dark",
  "description": "A Hyprland/Omarchy theme that approximates macOS 26 'Tahoe' (Liquid Glass). Derives all theme files from this JSON. Dark mode primary, heavy blur, squircle rounding, thin hairline borders, spring animations, SF-like typography.",
  "design_language": {
    "name": "Liquid Glass (macOS 26 'Tahoe')",
    "principles": [
      "Translucent glass materials with dynamic refraction feel",
      "Heavy blur + vibrancy for depth (content behind shows through)",
      "Continuous squircle corners (not circular arcs)",
      "Hairline borders (1px), relies on shadow for separation",
      "Spring-based animations with slight overshoot",
      "Minimal gaps, windows feel like floating glass panes",
      "System grays are warm-neutral, not blueish"
    ],
    "references": [
      "macOS 26 Tahoe system visual language",
      "Apple HIG: Materials, Color, Motion, Layout",
      "iOS 26 Liquid Glass materials"
    ]
  },

  "palette": {
    "semantic": {
      "background_primary":   "#1C1C1E",
      "background_secondary": "#2C2C2E",
      "background_tertiary":  "#3A3A3C",
      "surface_elevated":     "#2C2C2E",
      "surface_glass":         "rgba(28,28,30,0.62)",
      "separator":            "#38383A",
      "separator_opaque":     "#545458",
      "label_primary":        "#FFFFFF",
      "label_secondary":      "rgba(235,235,245,0.60)",
      "label_tertiary":       "rgba(235,235,245,0.30)",
      "label_quaternary":     "rgba(235,235,245,0.18)",
      "fill_primary":         "rgba(120,120,128,0.36)",
      "fill_secondary":       "rgba(120,120,128,0.32)",
      "fill_tertiary":        "rgba(118,118,128,0.24)",
      "fill_quaternary":      "rgba(118,118,128,0.18)",
      "accent":               "#D1D1D6",
      "accent_hover":         "#E5E5EA",
      "accent_gradient_stops": ["#C7C7CC", "#AEAEB2", "#8E8E93"],
      "accent_gradient_alpha": [0.50, 0.43, 0.40],
      "accent_gradient_angle_deg": 135,
      "_accent_note": "Metallic chromatic — muted silver sheen. Tightened luminance range (no near-white highlight, no deep shadow) and ~40-50% alpha so the border reads as a soft chrome reflection rather than a high-contrast outline."
    },
    "system_colors_dark": {
      "red":     "#FF453A",
      "orange":  "#FF9F0A",
      "yellow":  "#FFD60A",
      "green":   "#30D158",
      "mint":    "#66D4CF",
      "teal":    "#40CBE0",
      "cyan":    "#64D2FF",
      "blue":    "#0A84FF",
      "indigo":  "#5E5CE6",
      "purple":  "#BF5AF2",
      "pink":    "#FF375F",
      "brown":   "#AC8E68",
      "gray":    "#8E8E93",
      "gray2":   "#636366",
      "gray3":   "#48484A",
      "gray4":   "#3A3A3C",
      "gray5":   "#2C2C2E",
      "gray6":   "#1C1C1E"
    },
    "system_colors_light": {
      "red":     "#FF3B30",
      "orange":  "#FF9500",
      "yellow":  "#FFCC00",
      "green":   "#34C759",
      "mint":    "#00C7BE",
      "teal":    "#30B0C7",
      "cyan":    "#32ADE6",
      "blue":    "#007AFF",
      "indigo":  "#5856D6",
      "purple":  "#AF52DE",
      "pink":    "#FF2D55",
      "brown":   "#A2845E"
    },
    "traffic_lights": {
      "close":   "#FF5F57",
      "minimize":"#FEBC2E",
      "maximize":"#28C840"
    },
    "ansi_16": {
      "_comment": "ANSI palette tuned to macOS Terminal 'Pro' style, adapted for Tahoe dark vibrancy",
      "color0":  "#1C1C1E",
      "color1":  "#FF453A",
      "color2":  "#30D158",
      "color3":  "#FFD60A",
      "color4":  "#0A84FF",
      "color5":  "#BF5AF2",
      "color6":  "#64D2FF",
      "color7":  "#EBEBF5",
      "color8":  "#48484A",
      "color9":  "#FF6961",
      "color10": "#5DE396",
      "color11": "#FFE066",
      "color12": "#409CFF",
      "color13": "#DA8FFF",
      "color14": "#8FE1FF",
      "color15": "#FFFFFF"
    }
  },

  "typography": {
    "font_family_ui": "SF Pro Display, Inter, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif",
    "font_family_text": "SF Pro Text, Inter, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif",
    "font_family_mono": "SF Mono, JetBrainsMono Nerd Font, 'Cascadia Code', monospace",
    "font_family_fallback_ui": "Inter, JetBrainsMono Nerd Font, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "menu_bar": {
      "size_px": 12,
      "weight": 500
    },
    "body": {
      "size_px": 13,
      "line_height": 1.35
    },
    "caption": {
      "size_px": 11
    },
    "mono": {
      "size_px": 12
    },
    "letter_spacing_tight": "-0.01em"
  },

  "geometry": {
    "radius": {
      "window": 12,
      "popover": 10,
      "sheet": 14,
      "button": 8,
      "pill": 999,
      "menu_bar_item": 10,
      "dock": 28,
      "notification": 16,
      "notification_inner": 12,
      "launcher": 14,
      "launcher_item": 10
    },
    "rounding_power": {
      "_comment": "Hyprland rounding_power: 4.0 = squircle — the macOS continuous-corner curve",
      "value": 4.0
    },
    "border": {
      "active_width_px": 1,
      "inactive_width_px": 1,
      "hairline_alpha": 0.24
    },
    "gaps": {
      "_comment": "macOS-breathing-room gaps. Wider inner+outer so windows feel like floating glass panes with space around them.",
      "inner_px": 10,
      "outer_px": 18,
      "workspace_outer_px": 18
    },
    "waybar_bar": {
      "height_px": 28,
      "margin_top_px": 6,
      "margin_horizontal_px": 8,
      "pill_radius_px": 14,
      "item_padding_px": 8
    },
    "dock_region_reserved_px": 72
  },

  "materials": {
    "_comment": "Translucent glass materials — mapped to Hyprland blur + opacity for window content, and to GTK CSS alphas for UI chrome",
    "regular": {
      "alpha": 0.72,
      "blur_px": 30,
      "vibrancy": 0.18,
      "saturation": 1.18
    },
    "thick": {
      "alpha": 0.86,
      "blur_px": 40,
      "vibrancy": 0.12,
      "saturation": 1.2
    },
    "chrome": {
      "_comment": "Menu bar / dock / titlebars",
      "alpha": 0.62,
      "blur_px": 50,
      "vibrancy": 0.24,
      "saturation": 1.3
    },
    "popover": {
      "alpha": 0.80,
      "blur_px": 40,
      "vibrancy": 0.18
    },
    "sheet": {
      "alpha": 0.92,
      "blur_px": 30
    }
  },

  "shadow": {
    "window_active": {
      "color": "rgba(0,0,0,0.45)",
      "blur_px": 40,
      "offset_y_px": 12,
      "spread_px": 0,
      "hyprland": { "range": 40, "render_power": 3, "sharp": false, "ignore_window": true }
    },
    "window_inactive": {
      "color": "rgba(0,0,0,0.28)",
      "blur_px": 24,
      "offset_y_px": 6,
      "hyprland": { "range": 24, "render_power": 3 }
    },
    "popover": {
      "color": "rgba(0,0,0,0.35)",
      "blur_px": 50,
      "offset_y_px": 20
    },
    "notification": {
      "color": "rgba(0,0,0,0.30)",
      "blur_px": 30,
      "offset_y_px": 10
    },
    "dock": {
      "color": "rgba(0,0,0,0.40)",
      "blur_px": 60,
      "offset_y_px": 20
    }
  },

  "motion": {
    "_comment": "Spring-based animations. Apple's signature easings — snappy with subtle overshoot",
    "bezier_curves": {
      "standard":   { "points": [0.32, 0.72, 0.0, 1.0], "note": "Apple default 'easeInOut' approximation" },
      "swift_out":  { "points": [0.4, 0.0, 0.2, 1.0],  "note": "Material-ish ease-out for fast entries" },
      "swift_in":   { "points": [0.4, 0.0, 1.0, 1.0],  "note": "Fast ease-in for exits" },
      "smooth":     { "points": [0.23, 1.0, 0.32, 1.0], "note": "easeOutQuint — smooth tail" },
      "snappy":     { "points": [0.22, 1.0, 0.35, 1.0], "note": "Snappy ease-out" },
      "liquid":     { "points": [0.2, 0.8, 0.2, 1.2],  "note": "Slight overshoot — 'Liquid Glass' bounce" },
      "macspring":  { "points": [0.18, 1.08, 0.35, 1.06], "note": "Apple-style spring with settle" },
      "overshoot":  { "points": [0.13, 0.99, 0.29, 1.08], "note": "Popover entry overshoot" },
      "fade":       { "points": [0.5, 0.5, 0.75, 1.0], "note": "Near-linear for fades" }
    },
    "durations_ms": {
      "hover":    150,
      "focus":    200,
      "layer":    180,
      "window":   350,
      "workspace":400,
      "sheet":    450,
      "spring_settle": 600
    },
    "hyprland_animations": {
      "_comment": "Hyprland uses ds (deciseconds); durations below are in ds. Derived from durations_ms/100.",
      "windows":          { "enabled": true, "duration_ds": 3.5, "curve": "macspring", "style": "slide" },
      "windowsIn":        { "enabled": true, "duration_ds": 4.0, "curve": "macspring", "style": "popin 88%" },
      "windowsOut":       { "enabled": true, "duration_ds": 2.2, "curve": "swift_in",  "style": "popin 88%" },
      "windowsMove":      { "enabled": true, "duration_ds": 3.2, "curve": "snappy" },
      "border":           { "enabled": true, "duration_ds": 5.0, "curve": "smooth" },
      "borderangle":      { "enabled": true, "duration_ds": 7.0, "curve": "smooth" },
      "fade":             { "enabled": true, "duration_ds": 3.0, "curve": "fade" },
      "fadeIn":           { "enabled": true, "duration_ds": 2.2, "curve": "fade" },
      "fadeOut":          { "enabled": true, "duration_ds": 1.8, "curve": "fade" },
      "workspaces":       { "enabled": true, "duration_ds": 4.0, "curve": "smooth", "style": "slide" },
      "specialWorkspace": { "enabled": true, "duration_ds": 3.5, "curve": "liquid",  "style": "slidevert" },
      "layers":           { "enabled": true, "duration_ds": 2.0, "curve": "standard" },
      "layersIn":         { "enabled": true, "duration_ds": 2.5, "curve": "overshoot", "style": "popin 80%" },
      "layersOut":        { "enabled": true, "duration_ds": 1.5, "curve": "swift_in",  "style": "popin 90%" },
      "fadeLayersIn":     { "enabled": true, "duration_ds": 2.0, "curve": "fade" },
      "fadeLayersOut":    { "enabled": true, "duration_ds": 1.6, "curve": "fade" }
    }
  },

  "hyprland": {
    "general": {
      "gaps_in": 6,
      "gaps_out": 10,
      "border_size": 1,
      "col_active_border_rgba": "rgba(FFFFFF3D)",
      "col_inactive_border_rgba": "rgba(0000001F)",
      "resize_on_border": true,
      "extend_border_grab_area": 12,
      "allow_tearing": false,
      "layout": "dwindle"
    },
    "decoration": {
      "rounding": 12,
      "rounding_power": 4.0,
      "active_opacity": 0.97,
      "inactive_opacity": 0.90,
      "fullscreen_opacity": 1.0,
      "dim_inactive": false,
      "dim_strength": 0.08,
      "blur": {
        "enabled": true,
        "size": 8,
        "passes": 3,
        "ignore_opacity": true,
        "new_optimizations": true,
        "xray": false,
        "noise": 0.03,
        "contrast": 1.1,
        "brightness": 0.95,
        "vibrancy": 0.28,
        "vibrancy_darkness": 0.20
      },
      "shadow": {
        "enabled": true,
        "range": 40,
        "render_power": 3,
        "ignore_window": true,
        "color": "rgba(00000073)",
        "color_inactive": "rgba(00000047)",
        "offset": [0, 12]
      }
    },
    "misc": {
      "background_color_rgba": "rgb(000000)"
    },
    "group": {
      "col_border_active_rgba": "rgba(FFFFFF3D)",
      "col_border_inactive_rgba": "rgba(0000001F)",
      "groupbar": {
        "font_family": "SF Pro Display",
        "font_size": 11,
        "height": 24,
        "gaps_in": 4,
        "gaps_out": 0,
        "rounding": 10,
        "rounding_power": 4.0,
        "text_color_rgba": "rgba(FFFFFFEE)",
        "col_active_rgba": "rgba(0A84FF66)",
        "col_inactive_rgba": "rgba(FFFFFF11)"
      }
    },
    "layer_rules_blur": [
      "waybar",
      "walker",
      "notifications",
      "swayosd",
      "logout_dialog",
      "hyprpicker"
    ]
  },

  "components": {
    "menu_bar": {
      "mapping": "Waybar (top)",
      "material": "none",
      "background_css": "transparent",
      "_background_note": "Bar strip fully transparent. Earlier 0.30-alpha chrome showed kawase-blur noise artifacts against busy wallpapers; floating text over the wallpaper reads cleaner.",
      "text_color": "#FFFFFF",
      "text_shadow_css": "0 0 1px rgba(0,0,0,0.4)",
      "muted_color": "rgba(235,235,245,0.70)",
      "height_px": 28,
      "padding_x_px": 12,
      "pill_bg_hover": "rgba(255,255,255,0.12)",
      "pill_bg_active": "rgba(255,255,255,0.22)",
      "pill_radius_px": 999
    },
    "dock": {
      "mapping": "Not a first-class Omarchy component; approximated via walker in dock mode OR floating bottom waybar (out of scope for v1)",
      "note": "Reserve bottom area; keep workspace list on top bar"
    },
    "launcher": {
      "mapping": "Walker",
      "material": "thick",
      "background_css": "rgba(28,28,30,0.70)",
      "border_css": "1px solid rgba(255,255,255,0.08)",
      "radius_px": 14,
      "item_radius_px": 10,
      "item_hover_bg": "rgba(255,255,255,0.10)",
      "item_selected_bg": "rgba(10,132,255,0.28)",
      "item_selected_text": "#FFFFFF",
      "search_bg": "rgba(255,255,255,0.08)",
      "search_radius_px": 10,
      "shadow_css": "0 20px 50px rgba(0,0,0,0.45)"
    },
    "notifications": {
      "mapping": "Mako",
      "material": "popover",
      "background": "rgba(28,28,30,0.80)",
      "border": "rgba(255,255,255,0.10)",
      "text": "#FFFFFF",
      "accent_border": "#0A84FF",
      "radius_px": 16,
      "padding_px": 16,
      "width_px": 420,
      "height_px": 120,
      "margin_px": 12,
      "outer_margin_px": 10,
      "default_timeout_ms": 5000,
      "anchor": "top-right"
    },
    "lock_screen": {
      "mapping": "Hyprlock",
      "background_rgba": "rgba(0,0,0,0.35)",
      "inner_rgba": "rgba(28,28,30,0.60)",
      "outer_rgba": "rgba(255,255,255,0.20)",
      "font_color": "#FFFFFF",
      "check_color": "#0A84FF",
      "clock_font": "SF Pro Display",
      "clock_size_px": 96
    },
    "terminal": {
      "mapping": "alacritty / kitty / ghostty (user's choice, all generated)",
      "background": "#1C1C1E",
      "foreground": "#EBEBF5",
      "cursor": "#FFFFFF",
      "window_opacity_active": 0.75,
      "window_opacity_inactive": 0.65,
      "_opacity_note": "Applied via Hyprland windowrule on tag:terminal, overriding omarchy's default 0.97/0.9. Relies on decoration.blur for the glass effect behind the terminal.",
      "selection_fg": "#1C1C1E",
      "selection_bg": "#D1D1D6"
    },
    "osd": {
      "mapping": "SwayOSD",
      "background": "#1C1C1E",
      "border": "#FFFFFF",
      "progress": "#0A84FF"
    }
  },

  "apps": {
    "vscode": {
      "name": "Default Dark Modern",
      "extension": ""
    },
    "vscode_alt": {
      "name": "GitHub Dark Default",
      "extension": "GitHub.github-vscode-theme"
    },
    "neovim": {
      "plugin": "folke/tokyonight.nvim",
      "colorscheme": "tokyonight-moon",
      "rationale": "Closest built-in scheme to Tahoe dark grays; clean and blue-accented"
    },
    "btop": {
      "main_bg": "#1C1C1E",
      "main_fg": "#EBEBF5",
      "title": "#FFFFFF",
      "hi_fg": "#0A84FF",
      "selected_bg": "#2C2C2E",
      "selected_fg": "#FFFFFF"
    },
    "icons": {
      "_comment": "Omarchy's theme-set-gnome pipeline applies the named icon theme. Yaru-blue matches macOS accent; fallback Papirus-Dark.",
      "primary": "Yaru-blue",
      "fallback": "Papirus-Dark"
    }
  },

  "wallpapers": {
    "_comment": "Need at least one bg image. If Tahoe-like wallpaper isn't present, substitute a dark gradient solid or a borrowed matte-black/koyanagi image.",
    "required_count_min": 1,
    "candidates": [
      "tahoe-dark-gradient.jpg",
      "liquid-glass-abstract.jpg"
    ]
  },

  "notes": {
    "limitations_vs_real_macos": [
      "Hyprland has no real 'magnification' dock effect — approximate via Walker",
      "True Liquid Glass has refraction/parallax; Hyprland blur is kawase — we emulate with vibrancy",
      "SF Pro is not redistributable; theme falls back to Inter if SF not installed",
      "Traffic-light window controls are GTK/libadwaita-dependent and not rendered by Hyprland"
    ],
    "prerequisites_optional": [
      "Install SF Pro Display/Text (via Apple developer site) for best match",
      "Install Papirus-Dark for closer icon match",
      "Install 'Inter' font as fallback"
    ]
  }
}
